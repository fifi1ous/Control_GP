+@echo off
+rem Downloads the Python packages and Poppler needed by Control_GP.
+rem Control_GP.exe offers this automatically on the first start; run this
+rem file manually only if that failed or to repair the installation.
+powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0tools\setup_deps.ps1" %*
+echo.
+pause
diff --git a/src/app/firstrunsetup.cpp b/src/app/firstrunsetup.cpp
new file mode 100644
index 0000000..349d368
--- /dev/null
+++ b/src/app/firstrunsetup.cpp
@@ -0,0 +1,183 @@
+#include "firstrunsetup.h"
+
+#include <QCoreApplication>
+#include <QCryptographicHash>
+#include <QDialog>
+#include <QDialogButtonBox>
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QFontDatabase>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QLabel>
+#include <QMessageBox>
+#include <QPlainTextEdit>
+#include <QProcess>
+#include <QProgressBar>
+#include <QPushButton>
+#include <QTemporaryFile>
+#include <QVBoxLayout>
+
+namespace {
+
+QDir appDir()
+{
+    return QDir(QCoreApplication::applicationDirPath());
+}
+
+QString setupScriptPath()
+{
+    return appDir().filePath("tools/setup_deps.ps1");
+}
+
+// setup_deps.ps1 writes python-embed/.installed.json with the SHA256 of
+// requirements.txt it installed. PowerShell 5.1 may add a UTF-8 BOM.
+bool pythonPackagesReady()
+{
+    QFile req(appDir().filePath("requirements.txt"));
+    if (!req.open(QIODevice::ReadOnly))
+        return false;
+    const QByteArray expected =
+        QCryptographicHash::hash(req.readAll(), QCryptographicHash::Sha256).toHex().toUpper();
+
+    QFile stamp(appDir().filePath("python-embed/.installed.json"));
+    if (!stamp.open(QIODevice::ReadOnly))
+        return false;
+    QByteArray data = stamp.readAll();
+    if (data.startsWith("\xEF\xBB\xBF"))
+        data.remove(0, 3);
+
+    const QJsonObject obj = QJsonDocument::fromJson(data).object();
+    return obj.value("requirements").toString().toLatin1().toUpper() == expected;
+}
+
+bool popplerReady()
+{
+    return QFileInfo::exists(appDir().filePath("poppler/Library/bin/pdftoppm.exe"));
+}
+
+bool dependenciesReady()
+{
+    return pythonPackagesReady() && popplerReady();
+}
+
+bool appDirWritable()
+{
+    QTemporaryFile probe(appDir().filePath("write-test-XXXXXX.tmp"));
+    return probe.open();
+}
+
+// Runs setup_deps.ps1 in a modal dialog that shows its output.
+// Returns true when the script finished with exit code 0.
+bool runSetupScript()
+{
+    QDialog dlg;
+    dlg.setWindowTitle(QStringLiteral("Control_GP – příprava prvního spuštění"));
+    dlg.resize(760, 460);
+
+    auto *layout = new QVBoxLayout(&dlg);
+    auto *info = new QLabel(QStringLiteral(
+        "Stahuji Python knihovny a Poppler. Podle rychlosti připojení to může trvat několik minut."));
+    info->setWordWrap(true);
+    auto *progress = new QProgressBar;
+    progress->setRange(0, 0);  // indeterminate while the script runs
+    auto *log = new QPlainTextEdit;
+    log->setReadOnly(true);
+    log->setFont(QFontDatabase::systemFont(QFontDatabase::FixedFont));
+    auto *buttons = new QDialogButtonBox(QDialogButtonBox::Close);
+    buttons->button(QDialogButtonBox::Close)->setEnabled(false);
+
+    layout->addWidget(info);
+    layout->addWidget(progress);
+    layout->addWidget(log, 1);
+    layout->addWidget(buttons);
+    QObject::connect(buttons, &QDialogButtonBox::rejected, &dlg, &QDialog::reject);
+
+    QProcess proc;
+    proc.setProcessChannelMode(QProcess::MergedChannels);
+    proc.setWorkingDirectory(appDir().absolutePath());
+
+    bool ok = false;
+
+    QObject::connect(&proc, &QProcess::readyReadStandardOutput, &dlg, [&]() {
+        const QString text = QString::fromLocal8Bit(proc.readAllStandardOutput());
+        log->appendPlainText(text.trimmed());
+    });
+
+    QObject::connect(&proc, &QProcess::finished, &dlg,
+                     [&](int exitCode, QProcess::ExitStatus status) {
+        ok = (status == QProcess::NormalExit && exitCode == 0);
+        progress->setRange(0, 1);
+        progress->setValue(ok ? 1 : 0);
+        info->setText(ok
+            ? QStringLiteral("Hotovo. Po zavření okna se aplikace spustí.")
+            : QStringLiteral("Stažení se nepodařilo. Výpis výše ukazuje, kde nastala chyba. "
+                             "Zkontrolujte připojení k internetu a spusťte aplikaci znovu, "
+                             "případně spusťte Setup.cmd."));
+        buttons->button(QDialogButtonBox::Close)->setEnabled(true);
+    });
+
+    QObject::connect(&proc, &QProcess::errorOccurred, &dlg, [&](QProcess::ProcessError err) {
+        if (err != QProcess::FailedToStart)
+            return;
+        info->setText(QStringLiteral("Nepodařilo se spustit PowerShell. Spusťte prosím Setup.cmd ručně."));
+        progress->setRange(0, 1);
+        progress->setValue(0);
+        buttons->button(QDialogButtonBox::Close)->setEnabled(true);
+    });
+
+    proc.start(QStringLiteral("powershell.exe"),
+               { QStringLiteral("-NoProfile"),
+                 QStringLiteral("-ExecutionPolicy"), QStringLiteral("Bypass"),
+                 QStringLiteral("-File"), QDir::toNativeSeparators(setupScriptPath()) });
+
+    dlg.exec();
+
+    // Closed while still running (window close button): stop the script.
+    if (proc.state() != QProcess::NotRunning) {
+        proc.kill();
+        proc.waitForFinished(5000);
+        return false;
+    }
+    return ok;
+}
+
+} // namespace
+
+bool FirstRunSetup::ensureDependencies()
+{
+    // Developer build: dependencies are synced next to the exe by CMake.
+    if (!QFileInfo::exists(setupScriptPath()))
+        return true;
+
+    if (dependenciesReady())
+        return true;
+
+    if (!appDirWritable()) {
+        QMessageBox::critical(nullptr, QStringLiteral("Control_GP"),
+            QStringLiteral("Do složky aplikace nelze zapisovat:\n%1\n\n"
+                           "Rozbalte Control_GP do složky, kam máte právo zápisu, "
+                           "například do Dokumentů, a spusťte ho znovu.")
+                .arg(QDir::toNativeSeparators(appDir().absolutePath())));
+        return false;
+    }
+
+    const auto answer = QMessageBox::question(nullptr, QStringLiteral("Control_GP"),
+        QStringLiteral("Před prvním použitím je potřeba stáhnout Python knihovny a Poppler "
+                       "(řádově 100 MB). Stažení proběhne jen jednou.\n\nStáhnout nyní?"),
+        QMessageBox::Yes | QMessageBox::No, QMessageBox::Yes);
+    if (answer != QMessageBox::Yes)
+        return false;
+
+    if (!runSetupScript())
+        return false;
+
+    if (!dependenciesReady()) {
+        QMessageBox::critical(nullptr, QStringLiteral("Control_GP"),
+            QStringLiteral("Závislosti se nepodařilo připravit. Spusťte prosím Setup.cmd "
+                           "ve složce aplikace a sledujte výpis."));
+        return false;
+    }
+    return true;
+}
