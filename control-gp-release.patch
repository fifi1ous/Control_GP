@@ -0,0 +1,20 @@
+#ifndef FIRSTRUNSETUP_H
+#define FIRSTRUNSETUP_H
+
+// First-run preparation of a released build.
+//
+// The release ZIP ships Control_GP.exe with the embeddable Python (without
+// packages), but not the Python packages from requirements.txt nor Poppler.
+// Before the interpreter starts, ensureDependencies() checks that both are in
+// place and, if not, offers to run tools/setup_deps.ps1, showing its output.
+//
+// In a developer build (no tools/setup_deps.ps1 next to the exe) the check is
+// skipped, because the dependencies are synced there by CMake.
+namespace FirstRunSetup
+{
+    // Returns true when the application can start. Must be called after
+    // QApplication is constructed and before PythonManager::bootstrapInterpreter().
+    bool ensureDependencies();
+}
+
+#endif // FIRSTRUNSETUP_H
diff --git a/src/app/main.cpp b/src/app/main.cpp
index f3fccaa..bf5f51a 100644
--- a/src/app/main.cpp
+++ b/src/app/main.cpp
@@ -1,4 +1,5 @@
 #include "mainwindow.h"
+#include "firstrunsetup.h"
 #include "pythonmanager.h"
 
 #include <QApplication>
@@ -15,6 +16,10 @@ int main(int argc, char *argv[])
     // QCoreApplication::applicationDirPath() to locate the bundled Python runtime.
     QApplication a(argc, argv);
 
+    // Released build: download Python packages and Poppler before the first start.
+    if (!FirstRunSetup::ensureDependencies())
+        return 1;
+
     // Bootstrap the embedded Python interpreter with a configuration that points
